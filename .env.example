# Supabase browser client configuration (publishable values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase project credentials (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional deployment-specific key (takes precedence over the legacy key above).
AGENTGUARD_SUPABASE_SERVICE_ROLE_KEY=

# V1 execution adapter. OutLayer is replaceable; ENCU policy and ledger logic are provider-neutral.
ENCU_EXECUTION_PROVIDER=outlayer

# OutLayer custody API. Use a dedicated testnet wallet and API key for Preview.
AGENTGUARD_NETWORK=testnet
OUTLAYER_BASE_URL=https://testnet-api.outlayer.ai
OUTLAYER_API_KEY=
OUTLAYER_NEAR_ADDRESS=
NEAR_RPC_URL=https://rpc.testnet.near.org

# Long random secret used by the primary agent to authenticate with AgentGuard.
AGENTGUARD_AGENT_TOKEN=

# Separate long random secret for dashboard and administrative operations.
AGENTGUARD_ADMIN_TOKEN=

# Per-transaction cap in yoctoNEAR.
AGENTGUARD_MAX_TRANSFER_YOCTO=1000000000000000000000000