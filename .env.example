# Supabase project credentials (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OutLayer custody API. Use the testnet base URL from current OutLayer docs.
OUTLAYER_BASE_URL=
OUTLAYER_API_KEY=

# Long random secret used by the primary agent to authenticate with AgentGuard.
AGENTGUARD_AGENT_TOKEN=

# Separate long random secret for dashboard and administrative operations.
AGENTGUARD_ADMIN_TOKEN=

# Per-transaction cap in yoctoNEAR.
AGENTGUARD_MAX_TRANSFER_YOCTO=1000000000000000000000000